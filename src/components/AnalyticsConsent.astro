---
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
---

<section
	class="consent-banner"
	data-analytics-consent
	data-measurement-id={measurementId || ''}
	data-base-path={import.meta.env.BASE_URL}
	role="dialog"
	aria-modal="false"
	aria-labelledby="consent-title"
	aria-describedby="consent-description"
	hidden
>
	<div class="consent-copy">
		<p class="consent-kicker">Privacidade</p>
		<h2 id="consent-title">Ajude a melhorar o Tech Tatu</h2>
		<p id="consent-description">
			Podemos usar o Google Analytics somente para entender métricas de uso, como quais páginas são mais visitadas.
			Não usamos esses dados para anúncios. Você escolhe e pode mudar de ideia quando quiser.
		</p>
	</div>
	<div class="consent-actions">
		<button type="button" class="consent-accept">Aceitar métricas</button>
		<button type="button" class="consent-reject">Recusar</button>
	</div>
</section>

<script is:inline>
	(() => {
		const banner = document.querySelector('[data-analytics-consent]');
		if (!banner) return;

		const measurementId = banner.getAttribute('data-measurement-id');
		const basePath = (banner.getAttribute('data-base-path') || '/').replace(/\/$/, '') || '/';
		const cookieName = 'tech_tatu_analytics_consent';
		const year = 60 * 60 * 24 * 365;
		let gaLoaded = false;

		const readChoice = () => document.cookie
			.split('; ')
			.find((cookie) => cookie.startsWith(`${cookieName}=`))
			?.split('=')[1];

		const saveChoice = (choice) => {
			document.cookie = `${cookieName}=${choice}; Max-Age=${year}; Path=${basePath}; SameSite=Lax${location.protocol === 'https:' ? '; Secure' : ''}`;
		};

		const updateConsent = (analyticsStorage) => {
			if (typeof window.gtag === 'function') {
				window.gtag('consent', 'update', {
					analytics_storage: analyticsStorage,
					ad_storage: 'denied',
					ad_user_data: 'denied',
					ad_personalization: 'denied',
				});
			}
		};

		const loadAnalytics = () => {
			if (!measurementId || gaLoaded) return;
			gaLoaded = true;
			window.dataLayer = window.dataLayer || [];
			window.gtag = (...args) => window.dataLayer.push(args);
			window.gtag('consent', 'default', {
				analytics_storage: 'denied',
				ad_storage: 'denied',
				ad_user_data: 'denied',
				ad_personalization: 'denied',
			});
			window.gtag('consent', 'update', {
				analytics_storage: 'granted',
				ad_storage: 'denied',
				ad_user_data: 'denied',
				ad_personalization: 'denied',
			});
			window.gtag('js', new Date());
			window.gtag('config', measurementId);
			const script = document.createElement('script');
			script.async = true;
			script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`;
			document.head.appendChild(script);
		};

		const closeBanner = () => {
			banner.hidden = true;
			banner.setAttribute('aria-modal', 'false');
		};
		const openBanner = () => {
			banner.hidden = false;
			banner.setAttribute('aria-modal', 'true');
			banner.querySelector('button')?.focus();
		};

		banner.querySelector('.consent-accept')?.addEventListener('click', () => {
			saveChoice('accepted');
			loadAnalytics();
			closeBanner();
		});
		banner.querySelector('.consent-reject')?.addEventListener('click', () => {
			saveChoice('rejected');
			updateConsent('denied');
			closeBanner();
		});
		document.querySelector('[data-privacy-cookies]')?.addEventListener('click', (event) => {
			event.preventDefault();
			openBanner();
		});

		const choice = readChoice();
		if (choice === 'accepted') loadAnalytics();
		else if (!choice) openBanner();
	})();
</script>

<style>
	.consent-banner {
		position: fixed;
		z-index: 10;
		inset: auto 1rem 1rem;
		max-width: 760px;
		margin: 0 auto;
		padding: 1.25rem 1.5rem;
		display: flex;
		align-items: center;
		gap: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 14px;
		background: rgb(var(--surface-raised));
		box-shadow: var(--box-shadow);
		color: rgb(var(--gray-dark));
		font-size: 0.9rem;
		line-height: 1.45;
	}
	/* Keep the native hidden state stronger than the flex layout above. */
	.consent-banner[hidden] { display: none; }
	.consent-copy { flex: 1; }
	.consent-kicker { margin: 0 0 0.2rem; color: var(--accent); font-size: 0.75rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
	.consent-banner h2 { margin: 0 0 0.35rem; font-size: 1.3rem; }
	.consent-banner p { margin: 0; }
	.consent-actions { display: flex; flex-shrink: 0; flex-direction: column; gap: 0.5rem; }
	.consent-actions button { padding: 0.55rem 0.9rem; border: 1px solid var(--accent); border-radius: 6px; font: inherit; font-weight: 700; cursor: pointer; }
	.consent-accept { background: var(--accent); color: #fff; }
	.consent-reject { background: transparent; color: var(--accent); }
	.consent-actions button:hover { filter: brightness(1.1); }
	@media (max-width: 600px) {
		.consent-banner { align-items: stretch; flex-direction: column; gap: 1rem; }
		.consent-actions { flex-direction: row-reverse; }
		.consent-actions button { flex: 1; }
	}
</style>
