---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/gadgets-hardware.webp';
import { SITE_TITLE } from '../consts';
import { withBase, withoutBase } from '../lib/paths.js';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
	locale?: 'pt-BR' | 'en';
}

const pathname = withoutBase(Astro.url.pathname);
const { title, description, image = FallbackImage, locale = pathname === '/en' || pathname.startsWith('/en/') ? 'en' : 'pt-BR' } = Astro.props;
const canonicalURL = new URL(withBase(pathname), Astro.site);
const portuguesePath = pathname.replace(/^\/en(?=\/|$)/, '') || '/';
const englishPath = portuguesePath === '/' ? '/en/' : `/en${portuguesePath}`;
const portugueseURL = new URL(withBase(portuguesePath), Astro.site);
const englishURL = new URL(withBase(englishPath), Astro.site);
const imageURL = new URL(withBase(image.src), Astro.site);
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<script is:inline>
	(() => {
		// Apply the saved preference before the page paints to avoid a flash of the wrong theme.
		let storedTheme = null;
		try {
			storedTheme = window.localStorage.getItem('theme');
		} catch {
			// Storage can be unavailable in private browsing or restrictive environments.
		}

		let prefersDark = false;
		try {
			prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		} catch {
			// Fall back to the light theme when the system preference is unavailable.
		}

		const theme = storedTheme === 'light' || storedTheme === 'dark'
			? storedTheme
			: prefersDark ? 'dark' : 'light';
		document.documentElement.dataset.theme = theme;
	})();
</script>
<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
<link rel="sitemap" href={withBase('/sitemap-index.xml')} />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL(withBase('/rss.xml'), Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Font preloads -->
<link rel="preload" href={withBase('/fonts/atkinson-regular.woff')} as="font" type="font/woff" crossorigin />
<link rel="preload" href={withBase('/fonts/atkinson-bold.woff')} as="font" type="font/woff" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang="pt-BR" href={portugueseURL} />
<link rel="alternate" hreflang="en" href={englishURL} />
<link rel="alternate" hreflang="x-default" href={portugueseURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
