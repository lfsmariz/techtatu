---
const today = new Date();
import AnalyticsConsent from './AnalyticsConsent.astro';
import { withBase } from '../lib/paths.js';
interface Props { locale?: 'pt-BR' | 'en'; }
const { locale = 'pt-BR' } = Astro.props;
---

<footer>
	&copy; {today.getFullYear()} Luiz Mariz. All rights reserved.
	<div class="social-links">
		<a href="https://www.linkedin.com/in/luizfilipesmariz/" target="_blank">
			<span class="sr-only">Go to my GitHub repo</span>
			<svg viewBox="0 0 26 26" aria-hidden="true" width="32" height="32">
				<path
					fill="currentColor"
					d="M8,4H6C4.895,4,4,4.895,4,6v18c0,1.105,0.895,2,2,2h18c1.105,0,2-0.895,2-2V6C26,4.895,25.105,4,24,4z M10.954,22h-2.95 v-9.492h2.95V22z M9.449,11.151c-0.951,0-1.72-0.771-1.72-1.72c0-0.949,0.77-1.719,1.72-1.719c0.948,0,1.719,0.771,1.719,1.719 C11.168,10.38,10.397,11.151,9.449,11.151z M22.004,22h-2.948v-4.616c0-1.101-0.02-2.517-1.533-2.517 c-1.535,0-1.771,1.199-1.771,2.437V22h-2.948v-9.492h2.83v1.297h0.04c0.394-0.746,1.356-1.533,2.791-1.533 c2.987,0,3.539,1.966,3.539,4.522V22z"
				></path>
			</svg>
		</a>

		<a href="https://github.com/lfsmariz" target="_blank">
			<span class="sr-only">Go to my GitHub repo</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
				><path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				>
				</path>
			</svg>
		</a>

		<a href={withBase('/rss.xml')} target="_blank">
			<span class="sr-only">Go to my RSS feed</span>
			<svg
				fill="currentColor"
				height="30"
				width="30"
				viewBox="-271 273 256 256"
				><g>
					<path
						d="M-271,360v48.9c31.9,0,62.1,12.6,84.7,35.2c22.6,22.6,35.1,52.8,35.1,84.8v0.1h49.1c0-46.6-19-88.7-49.6-119.4 C-182.2,379-224.4,360.1-271,360z"
					></path>
					<path
						d="M-237,460.9c-9.4,0-17.8,3.8-24,10s-10,14.6-10,24c0,9.3,3.8,17.7,10,23.9c6.2,6.1,14.6,9.9,24,9.9s17.8-3.7,24-9.9 s10-14.6,10-23.9c0-9.4-3.8-17.8-10-24C-219.2,464.7-227.6,460.9-237,460.9z"
					></path>
					<path
						d="M-90.1,348.1c-46.3-46.4-110.2-75.1-180.8-75.1v48.9C-156.8,322-64.1,414.9-64,529h49C-15,458.4-43.7,394.5-90.1,348.1z"
					></path>
				</g>
			</svg>
		</a>
	</div>
	<a class="privacy-link" href="#privacy-cookies" data-privacy-cookies>{locale === 'en' ? 'Privacy and cookies' : 'Privacidade e cookies'}</a>
</footer>

<AnalyticsConsent />

<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.social-links {
		display: flex;
		justify-content: center;
		gap: 1em;
		margin-top: 1em;
	}
	.social-links a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	.social-links a:hover {
		color: rgb(var(--gray-dark));
	}
	.privacy-link {
		display: inline-block;
		margin-top: 1.25rem;
		font-size: 0.85rem;
	}
</style>
