---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description="Welcome to the Tech Tatu Blog!" locale="en" />
	</head>
	<body>
		<Header />
		<main>
			<h1>🚀 Welcome to Tech Tatu</h1>
			<p>
				Welcome to my digital space! Here you will find content about software
				development, from Golang and Java to Python and TypeScript, as well as
				insights into hardware, gadgets, and the latest tech trends. As a software
				engineer specializing in distributed systems and real-time data processing,
				I share practical experience with scalable architectures and high-performance
				solutions.
			</p>
			<p>
				Explore articles about digital security, privacy, careers, and tech culture,
				including tips for building strong teams. Whether you are a developer,
				hardware enthusiast, or simply curious about technology, you are in the
				right place to learn and find inspiration!
			</p>
		</main>
		<Footer locale="en" />
	</body>
</html>
